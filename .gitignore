# 根目录默认不进版本库，只放行下面列出的这几项。
# 以后新增顶层目录，要在这里补一行 !/目录名/，否则提交不上去。
# 单独放行某个被挡住的文件，用 git add -f 指定它。
/*
!/.github/
!/backend/
!/electron-app/
!/prompts/
!/scripts/
!/.gitignore
!/README.md
!/SkyArt成片后期规范.md

# macOS
.DS_Store

# Python 虚拟环境
backend/.venv/
backend/.venv_dist/

# PyInstaller 构建产物
backend/build/
backend/dist/

# 数据库文件
*.db

# 用户上传数据
backend/uploads/

# 本地运行日志
backend/logs/

# Electron 构建产物
electron-app/dist/
electron-app/backend-bin/
electron-app/node_modules/
electron-app/skyart.db

# Electron 运行日志
electron-app/logs/


# Copy to .env and fill in values
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (relative to backend/ directory)
DATABASE_URL=sqlite+aiosqlite:///./skyart.db

# Upload paths (relative to backend/)
UPLOAD_DIR=./uploads

# AI API Keys (fill in when ready)
# HappyHorse (DashScope) — 视频编辑接口
HAPPYHORSE_API_KEY=
HAPPYHORSE_BASE_URL=https://dashscope-us.aliyuncs.com/api/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# CORS origins (frontend)
CORS_ORIGINS=["http://localhost:3000","app://.", "file://"]
